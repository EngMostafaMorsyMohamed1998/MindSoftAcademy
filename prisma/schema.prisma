generator client {
  provider = "prisma-client-js"
}

// PostgreSQL / Supabase.
// For local Postgres: postgresql://USER:PASSWORD@localhost:5432/baccalaureate?schema=public
// For Supabase, set DATABASE_URL to the pooled URI (port 6543) and DIRECT_URL to the direct URI (port 5432).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String?
  image         String?
  emailVerified DateTime?
  points        Int       @default(0)
  role          Role      @default(STUDENT)
  createdAt     DateTime  @default(now())

  accounts    Account[]
  sessions    Session[]
  quizResults QuizResult[]

  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Course {
  id          String    @id @default(uuid())
  title       String // e.g. الرياضيات, الفيزياء
  description String?
  capsules    Capsule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}

model Capsule {
  id         String       @id @default(uuid())
  title      String
  videoUrl   String
  duration   Int          @default(15) // minutes; 2bac capsules are 15 by default
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions  Question[]
  quizResults QuizResult[]

  createdAt DateTime @default(now())

  @@index([courseId])
}

model Question {
  id            String   @id @default(uuid())
  text          String
  options       String[] // ["option A", "option B", "option C", "option D"]
  correctAnswer String // "A" | "B" | "C" | "D" (index 0–3)
  explanation   String?
  capsuleId     String
  capsule       Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)

  @@index([capsuleId])
}

model QuizResult {
  id             String   @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  capsuleId      String
  capsule        Capsule  @relation(fields: [capsuleId], references: [id], onDelete: Cascade)
  score          Int
  totalQuestions Int
  attemptedAt    DateTime @default(now())

  @@index([userId, attemptedAt])
  @@index([capsuleId])
  @@index([userId, capsuleId])
}

model ClassCode {
  id        String    @id
  code      String    @unique
  name      String
  phone     String
  createdAt DateTime
  usedAt    DateTime?
  usedById  String?
  points    Int       @default(0)

  @@index([phone])
}

model ClassMessage {
  id            String   @id
  studentId     String
  studentName   String
  from          String
  body          String
  createdAt     DateTime
  readByTeacher Boolean  @default(false)
  readByStudent Boolean  @default(false)

  @@index([studentId, createdAt])
}

model ClassExam {
  id             String   @id
  chapterId      String
  studentId      String
  name           String
  phone          String
  locale         String
  objectiveScore Int
  objectiveTotal Int
  essays         Json
  submittedAt    DateTime

  @@index([studentId, chapterId])
}

model ClassHomework {
  studentId   String
  lessonId    String
  score       Int
  total       Int
  passed      Boolean
  submittedAt DateTime

  @@id([studentId, lessonId])
}

model ClassUnlock {
  studentId String
  chapterId String
  reason    String
  createdAt DateTime

  @@id([studentId, chapterId])
}

model ClassEssayGrade {
  examId     String
  studentId  String
  questionId String
  score      Int
  note       String
  gradedAt   DateTime

  @@id([examId, questionId])
}
